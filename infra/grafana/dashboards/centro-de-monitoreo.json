    {
      "id": 8,
      "type": "table",
      "title": "Alertas recientes (las criticas primero)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT updated_at AS \"Hora\", severity AS \"Severidad\",\nalert_type AS \"Tipo\", zone_name AS \"Zona\", status AS \"Estado\", round(confidence::numeric, 2) AS \"Confianza\",\nCASE WHEN alert_type = 'POSIBLE_FALSO_POSITIVO' THEN NULL ELSE latency_ms END AS \"Latencia (ms)\", plate_masked AS \"Placa\", revision AS \"Rev.\"\nFROM v_alerts WHERE $__timeFilter(updated_at)\nORDER BY (status IN ('NEW','ESCALATED','UPDATED') AND severity = 'CRITICAL') DESC, updated_at DESC LIMIT 100",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Severidad"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "CRITICAL": {
                        "color": "red",
                        "index": 0,
                        "text": "CRITICA"
                      },
                      "HIGH": {
                        "color": "orange",
                        "index": 1,
                        "text": "ALTA"
                      },
                      "MEDIUM": {
                        "color": "yellow",
                        "index": 2,
                        "text": "MEDIA"
                      },
                      "LOW": {
                        "color": "green",
                        "index": 3,
                        "text": "BAJA"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Hora"
            },
            "properties": [
              {
                "id": "unit",
                "value": "time:YYYY-MM-DD HH:mm:ss"
              },
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Latencia (ms)"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
