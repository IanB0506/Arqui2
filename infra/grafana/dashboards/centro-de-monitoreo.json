    {
      "id": 7,
      "type": "geomap",
      "title": "Mapa de calor: eventos de riesgo y alertas",
      "description": "Calor = botones de panico, reportes ciudadanos y lecturas anomalas. Puntos = alertas (color por severidad). Las zonas son las regiones del centroide mas cercano, la misma regla con la que la ingesta asigna la zona; se dibujan aunque no haya internet para el mapa base.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT latitude, longitude, sensor_type, subtype, zone_name\nFROM v_events WHERE $__timeFilter(event_time) AND (anomalous OR sensor_type IN ('PANIC','CITIZEN_REPORT'))\nORDER BY event_time DESC LIMIT 5000",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT latitude, longitude, alert_type AS tipo, severity AS severidad, zone_name AS zona,\nCASE severity WHEN 'CRITICAL' THEN 4 WHEN 'HIGH' THEN 3 WHEN 'MEDIUM' THEN 2 ELSE 1 END AS nivel\nFROM v_alerts WHERE $__timeFilter(updated_at) AND zone_id > 0",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "-- Centroides de ZoneCatalog (etiquetas del mapa)\nSELECT zona, latitude, longitude FROM (VALUES\n('Zona 1', 14.642, -90.513),\n('Zona 2', 14.6595, -90.512),\n('Zona 3', 14.636, -90.525),\n('Zona 4', 14.624, -90.5165),\n('Zona 5', 14.626, -90.498),\n('Zona 6', 14.653, -90.496),\n('Zona 7', 14.635, -90.548),\n('Zona 8', 14.626, -90.532),\n('Zona 9', 14.606, -90.518),\n('Zona 10', 14.596, -90.506),\n('Zona 11', 14.608, -90.545),\n('Zona 12', 14.59, -90.538)\n) AS z(zona, latitude, longitude)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
