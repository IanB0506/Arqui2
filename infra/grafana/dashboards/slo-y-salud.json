    {
      "id": 13,
      "type": "table",
      "title": "Incumplimientos de SLO registrados",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT measured_at AS \"Hora\", alerts AS \"Alertas\", round(p95_ms::numeric) AS \"p95 (ms)\",\nround((within_slo_ratio * 100)::numeric, 1) AS \"% < 2 s\", round(freshness_p95_ms::numeric) AS \"Frescura p95 (ms)\"\nFROM slo_measurements WHERE $__timeFilter(measured_at) AND breached ORDER BY measured_at DESC LIMIT 50",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Hora"
            },
            "properties": [
              {
                "id": "unit",
                "value": "time:YYYY-MM-DD HH:mm:ss"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
