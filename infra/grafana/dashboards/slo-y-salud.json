          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT freshness_p95_ms FROM slo_measurements WHERE $__timeFilter(measured_at) ORDER BY measured_at DESC LIMIT 1",
          "format": "table",
