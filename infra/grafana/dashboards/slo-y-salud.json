    {
      "id": 6,
      "type": "timeseries",
      "title": "Latencia evento -> alerta vs objetivo de 2 s (mediciones cada 30 s)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
