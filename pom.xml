<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Centinela Urbano - Sistema de monitoreo perimetral urbano (simulacion)
        Proyecto final Arquitectura de Computadores II - UMG 2026

        POM padre: define versiones comunes y los modulos del sistema.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>gt.umg.centinela</groupId>
    <artifactId>centinela-urbano</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Centinela Urbano</name>
    <description>Simulacion de un sistema de monitoreo perimetral urbano orientado a eventos</description>

    <modules>
        <module>common</module>
        <module>sensor-simulator</module>
        <module>ingestion-service</module>
        <module>correlation-engine</module>
        <module>alert-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <shedlock.version>6.10.0</shedlock.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>gt.umg.centinela</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.javacrumbs.shedlock</groupId>
                <artifactId>shedlock-spring</artifactId>
                <version>${shedlock.version}</version>
            </dependency>
            <dependency>
                <groupId>net.javacrumbs.shedlock</groupId>
                <artifactId>shedlock-provider-jdbc-template</artifactId>
                <version>${shedlock.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
