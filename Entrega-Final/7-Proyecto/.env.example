# Mismo .env en todas las PCs: las IP, los puertos y los secretos deben coincidir.
# Lo más simple es crearlo con: centinela.cmd configurar

PLATE_HMAC_SECRET=cambie-esta-llave-por-una-larga-y-aleatoria
DB_PASSWORD=centinela
GRAFANA_DB_PASSWORD=grafana-reader
REDIS_PASSWORD=centinela-redis
OPERATOR_USER=operador
OPERATOR_PASSWORD=operador123
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
GRAFANA_ADMIN_PASSWORD=admin123

# runtime compila dentro de Docker; prebuilt usa los jar ya compilados (sin internet).
BUILD_TARGET=runtime

# Si Windows tiene reservado u ocupado un puerto: centinela.cmd puertos -Arreglar
SIMULATOR_PORT=8080
INGESTION_PORT=8081
CORRELATION_PORT=8082
ALERT_SERVICE_PORT=8083
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
DB_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=9092
KAFKA_EXTERNAL_PORT=29092
WORKER_INGESTION_PORT=8081
WORKER_CORRELATION_PORT=8082

# Solo para varias PCs. Con una IP de generador, C simula las 12 zonas; con dos, C la 1-6 y D la 7-12.
NODE_A_IP=192.168.1.10
NODE_B_IP=192.168.1.11
GENERATOR_IPS=192.168.1.12
WORKERS=false
SIMULATOR_ZONES=1,2,3,4,5,6
SIMULATOR_NODE_NAME=nodo-c
