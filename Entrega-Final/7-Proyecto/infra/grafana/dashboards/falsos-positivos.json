    {
      "id": 5,
      "type": "timeseries",
      "title": "Clasificacion de alertas en el tiempo",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT $__timeGroupAlias(updated_at, '5m'),\nCASE WHEN status = 'CONFIRMED' THEN 'Confirmada' WHEN status = 'FALSE_POSITIVE' THEN 'Falso positivo (operador)'\n     WHEN alert_type = 'POSIBLE_FALSO_POSITIVO' THEN 'Posible falso positivo (motor)' ELSE 'Sin validar' END AS metric,\ncount(*) FROM v_alerts WHERE $__timeFilter(updated_at) AND rule_id <> 'SISTEMA' GROUP BY 1, 2 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
