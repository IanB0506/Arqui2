          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT zone_name AS zona, count(*) AS total FROM v_alerts\nWHERE $__timeFilter(updated_at) AND alert_type = 'POSIBLE_FALSO_POSITIVO' GROUP BY zone_id, zone_name ORDER BY zone_id",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
