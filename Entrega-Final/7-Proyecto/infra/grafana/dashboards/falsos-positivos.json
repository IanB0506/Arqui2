    {
      "id": 8,
      "type": "table",
      "title": "Calidad de reglas por zona y ajuste adaptativo de umbral",
      "description": "Precision = confirmadas / validadas. Si es < 50 % el motor exige mas evidencia en esa zona (+0.10)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT rule_id AS \"Regla\", zone_id AS \"Zona\",\nvalidated AS \"Validadas\", confirmed AS \"Confirmadas\", false_positives AS \"Falsos positivos\", missed AS \"Omisiones\",\nround((precision * 100)::numeric, 1) AS \"Precision %\", threshold_adjustment AS \"Ajuste de umbral\", computed_at AS \"Calculado\"\nFROM rule_quality ORDER BY rule_id, zone_id",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Ajuste de umbral"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "blue",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 0
                    },
                    {
                      "color": "orange",
                      "value": 0.01
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Calculado"
            },
            "properties": [
              {
                "id": "unit",
                "value": "time:YYYY-MM-DD HH:mm:ss"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
