          "rawSql": "SELECT updated_at AS \"Hora\", zone_name AS \"Zona\", rule_id AS \"Regla\",\nstatus AS \"Estado\", description AS \"Explicacion\" FROM v_alerts\nWHERE $__timeFilter(updated_at) AND alert_type = 'POSIBLE_FALSO_POSITIVO' ORDER BY updated_at DESC LIMIT 50",
          "format": "table",
