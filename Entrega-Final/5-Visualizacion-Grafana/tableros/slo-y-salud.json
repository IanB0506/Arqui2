        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT measured_at AS time, p50_ms AS \"p50\", p95_ms AS \"p95\", p99_ms AS \"p99\"\nFROM slo_measurements WHERE $__timeFilter(measured_at) AND alerts > 0 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
