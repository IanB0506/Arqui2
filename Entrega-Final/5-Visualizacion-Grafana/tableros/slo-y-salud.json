  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "SLO-1 · 5 min",
      "description": "Objetivo: 95 % de las alertas HIGH/CRITICAL persistidas en menos de 2 s desde el evento que las disparo. Se mide en los ultimos 5 minutos, la ventana del SLO-1 (ADR-008), sin importar el rango del tablero: las alertas que esperaron durante una caida suben este valor solo mientras estan dentro de esos 5 minutos. La historia completa, con la causa de cada incumplimiento, esta en la serie de tiempo y en la tabla del tablero de SLO.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT 100.0 * avg(CASE WHEN latency_ms <= 2000 THEN 1 ELSE 0 END) FROM alert_revisions WHERE received_at > now() - INTERVAL '5 minutes' AND status IN ('NEW','ESCALATED') AND severity IN ('HIGH','CRITICAL')",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 90
              },
              {
                "color": "green",
                "value": 95
              }
            ]
          },
          "decimals": 1,
          "noValue": "Sin alertas"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "p50 · 5 min",
      "description": "Mediana de la latencia evento -> alerta guardada (HIGH/CRITICAL). Se mide en los ultimos 5 minutos, la ventana del SLO-1 (ADR-008), sin importar el rango del tablero: las alertas que esperaron durante una caida suben este valor solo mientras estan dentro de esos 5 minutos. La historia completa, con la causa de cada incumplimiento, esta en la serie de tiempo y en la tabla del tablero de SLO.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT percentile_cont(0.50) WITHIN GROUP (ORDER BY latency_ms) FROM alert_revisions WHERE received_at > now() - INTERVAL '5 minutes' AND status IN ('NEW','ESCALATED') AND severity IN ('HIGH','CRITICAL')",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
