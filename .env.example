# -----------------------------------------------------------------------------
# Configuración de Centinela Urbano. NUNCA subir el archivo .env al repositorio.
#
# En Windows lo más fácil es no editar este archivo a mano:
#   centinela.cmd configurar      (pregunta el modo, detecta la IP y revisa los puertos)
#
# En varias máquinas se usa EL MISMO .env en todas (cópielo a la raíz del repositorio de cada una):
# las IP, los puertos y los secretos deben coincidir en todos los nodos.
# -----------------------------------------------------------------------------

# Secretos (cambiar en cualquier despliegue real)
PLATE_HMAC_SECRET=cambie-esta-llave-por-una-larga-y-aleatoria
DB_PASSWORD=centinela
GRAFANA_DB_PASSWORD=grafana-reader
REDIS_PASSWORD=centinela-redis
OPERATOR_USER=operador
OPERATOR_PASSWORD=operador123
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
GRAFANA_ADMIN_PASSWORD=admin123

# "runtime" compila dentro de Docker (solo necesita Docker e internet la primera vez);
# "prebuilt" usa los jar de "mvnw.cmd package" (más rápido y sin internet)
BUILD_TARGET=runtime

# --- Puertos publicados en la máquina (cambiarlos si Windows los tiene reservados u ocupados) ---
# "centinela.cmd puertos -Arreglar" elige puertos libres automáticamente.
SIMULATOR_PORT=8080
INGESTION_PORT=8081
CORRELATION_PORT=8082
ALERT_SERVICE_PORT=8083
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
DB_PORT=5432
REDIS_PORT=6379
# Kafka: KAFKA_PORT en multi-nodo (nodo A); KAFKA_EXTERNAL_PORT en una sola máquina
KAFKA_PORT=9092
KAFKA_EXTERNAL_PORT=29092
# Workers de los nodos C/D (distintos de 8081/8082 si en la misma máquina corre el nodo B)
WORKER_INGESTION_PORT=8081
WORKER_CORRELATION_PORT=8082

# --- Solo para despliegue multi-nodo (carpeta deploy/) ---
NODE_A_IP=192.168.1.10
NODE_B_IP=192.168.1.11
# IP del nodo generador C, y la del nodo D si existe (máximo dos, separadas por coma).
# Con una IP, C simula las 12 zonas; con dos, C simula 1-6 y D 7-12. El nodo B las usa para Prometheus.
GENERATOR_IPS=192.168.1.12
# "true" levanta también los workers de ingesta y correlación en los nodos C/D
WORKERS=false
# Zonas que simula cada nodo generador (C: 1-6, D: 7-12). centinela.cmd las ajusta según el nodo.
SIMULATOR_ZONES=1,2,3,4,5,6
SIMULATOR_NODE_NAME=nodo-c
