# -----------------------------------------------------------------------------
# Copiar a .env y ajustar. NUNCA subir el archivo .env al repositorio.
# -----------------------------------------------------------------------------
# Secretos (cambiar en cualquier despliegue real)
PLATE_HMAC_SECRET=cambie-esta-llave-por-una-larga-y-aleatoria
DB_PASSWORD=centinela
GRAFANA_DB_PASSWORD=grafana-reader
REDIS_PASSWORD=centinela-redis
OPERATOR_USER=operador
OPERATOR_PASSWORD=operador123
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
GRAFANA_ADMIN_PASSWORD=admin123

# "runtime" compila dentro de Docker; "prebuilt" usa los jar de mvn package
BUILD_TARGET=runtime

# --- Solo para despliegue multi-nodo (carpeta deploy/) ---
NODE_A_IP=192.168.1.10
NODE_B_IP=192.168.1.11
# Zonas que simula cada nodo generador (C: 1-6, D: 7-12)
SIMULATOR_ZONES=1,2,3,4,5,6
SIMULATOR_NODE_NAME=nodo-c
